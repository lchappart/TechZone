{
	"info": {
		"name": "TechZone E-commerce API",
		"description": "Collection Postman pour l'API TechZone",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newuser@techzone.com\",\n  \"password\": \"password123\",\n  \"nom\": \"Dupont\",\n  \"prenom\": \"Jean\",\n  \"adresse\": \"123 Rue Test, Paris\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@techzone.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
									"}"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get All Products",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/products?page=0&size=12",
							"host": ["{{base_url}}"],
							"path": ["api", "products"],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "12"
								},
								{
									"key": "categoryId",
									"value": "",
									"disabled": true
								},
								{
									"key": "promotion",
									"value": "",
									"disabled": true
								},
								{
									"key": "stockStatus",
									"value": "",
									"disabled": true
								}
							]
						}
					}
				},
				{
					"name": "Get Product by ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/products/1",
							"host": ["{{base_url}}"],
							"path": ["api", "products", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Cart",
			"item": [
				{
					"name": "Get Cart",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/cart",
							"host": ["{{base_url}}"],
							"path": ["api", "cart"]
						}
					}
				},
				{
					"name": "Add to Cart",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{base_url}}/api/cart/add?productId=1&quantity=2",
							"host": ["{{base_url}}"],
							"path": ["api", "cart", "add"],
							"query": [
								{
									"key": "productId",
									"value": "1"
								},
								{
									"key": "quantity",
									"value": "2"
								}
							]
						}
					}
				},
				{
					"name": "Remove from Cart",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/api/cart/remove/1",
							"host": ["{{base_url}}"],
							"path": ["api", "cart", "remove", "1"]
						}
					}
				},
				{
					"name": "Update Cart Quantity",
					"request": {
						"method": "PUT",
						"url": {
							"raw": "{{base_url}}/api/cart/update?productId=1&quantity=3",
							"host": ["{{base_url}}"],
							"path": ["api", "cart", "update"],
							"query": [
								{
									"key": "productId",
									"value": "1"
								},
								{
									"key": "quantity",
									"value": "3"
								}
							]
						}
					}
				}
			]
		},
